<?xml version="1.0"?>
<ruleset name="RadykFW">
    <description>
        Advisory coding standard: security/correctness sniffs only.
        House style (space-before-paren etc.) is intentionally not enforced.
        CI runs this as a non-blocking step.
    </description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <file>plugin.init.php</file>
    <file>system</file>
    <file>modules</file>
    <file>tests</file>

    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="eval" value=""/>
                <element key="create_function" value=""/>
                <element key="mysql_query" value=""/>
                <element key="assert" value=""/>
            </property>
        </properties>
    </rule>
    <rule ref="Squiz.PHP.Eval"/>
    <rule ref="Generic.PHP.NoSilencedErrors"/>
    <rule ref="Generic.PHP.DisallowAlternativePHPTags"/>
    <!-- radykfw.php is a locked file; its missing EOF newline is not auto-fixed here. -->
    <rule ref="PSR2.Files.EndFileNewline">
        <exclude-pattern>radykfw\.php</exclude-pattern>
    </rule>
</ruleset>
