{
    "name": "radyklabs/radykfw",
    "description": "WordPress HMVC Framework with custom routing",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "RadykLabs",
            "email": "hello@radyklabs.com",
            "homepage": "https://radyklabs.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "RadykFW\\": "system/",
            "RadykFW\\Modules\\": "modules/"
        },
        "files": [
            "system/Helpers/utilities.helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RadykFW\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=WordPress system/ modules/",
        "cs:fix": "phpcbf --standard=WordPress system/ modules/",
        "analyse": "phpstan analyse system/ modules/"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}